# Groundwork configuration. Copy to `.env` and adjust. Never commit `.env`.
#
# All runtime models are free: open-weight via Ollama (default) or a free-tier
# hosted API. No paid APIs, credits or subscriptions are needed.

# --- Provider selection -----------------------------------------------------
# ollama : local open-weight model (default, data never leaves your machine)
# groq   : Groq free tier (hosted, needs a free API key)
# demo   : no model at all; replays hand labels for the bundled sample sets
#          (try the full flow in seconds; your own interviews return no findings)
# mock   : deterministic fake provider for tests
LLM_PROVIDER=ollama

# --- Generation settings (shared by all providers) ---------------------------
# Low temperature + fixed seed for reproducible analyses.
LLM_TEMPERATURE=0.1
LLM_SEED=42
# Generous timeout: CPU-only inference of a 7B model can be slow.
LLM_TIMEOUT_SECONDS=300
# Retries after invalid JSON / schema errors (first attempt not counted).
LLM_MAX_RETRIES=2
# Parallel LLM calls: keep 1 for a single local GPU.
LLM_CONCURRENCY=1

# --- Analysis -------------------------------------------------------------------
# Fuzzy quote matches below this similarity are rejected as unverified.
QUOTE_MATCH_THRESHOLD=0.92
# Transcript characters per extraction prompt (long interviews are chunked).
EXTRACTION_CHUNK_CHARS=6000

# --- Ollama (default) ---------------------------------------------------------
# Inside Docker Compose use http://ollama:11434 (or http://host.docker.internal:11434
# to reach an Ollama running on the host).
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:7b (Q4, ~4.7 GB) fits a 6 GB GPU. llama3.1:8b also works.
# For very small machines try qwen2.5:3b.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
# Set to true to force CPU inference (no GPU or not enough VRAM).
OLLAMA_FORCE_CPU=false

# --- Groq free tier (optional) ------------------------------------------------
# Get a free key at https://console.groq.com/keys . Free tier only; no billing.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- App ----------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/groundwork.db
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
